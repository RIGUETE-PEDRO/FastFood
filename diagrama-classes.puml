@startuml
title FlashFood — Diagrama de Classes: estrutura e relações principais
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Controladores" {
  abstract class Controller <<Base da aplicação>>
  class IndexController {
    +index()
  }
  class PizzaController {
    +Pizza()
  }
  class LanchesController {
    +Lanches()
  }
  class BebidasController {
    +Bebidas()
  }
  class PorcaoController {
    +porcao()
  }
  class CarrinhoController {
    +adicionarAoCarrinho(request)
    +verCarrinho()
    +registrarPedido(request)
  }
  class PedidoController {
    +pedidosFiltro(request)
    +verpedido()
  }
  class PedidosFeitosController {
    +verPedidosAdmin()
    +atualizarStatus(request, pedido)
    +avancarStatus(pedido)
    +cancelar(pedido)
    +gerarCumpom(pedido)
  }
  class EntregasController {
    +index()
    +aceitar(pedido)
    +finalizar(pedido)
  }
  class LoginController {
    +login(request)
    +logout()
    +recuperarSenha(request)
    +atualizarSenha(request)
  }
  class RegisterController {
    +register(request)
    +registerFuncionario(request)
  }
  class AdminController {
    +bemVindo(request)
    +configuracoes()
    +atualizarConfiguracoes(request)
    +atualizarConfiguracoesImpressao(request)
  }
  class GerenciamentoUsuarioController {
    +gerenciamentoFuncionario()
    +atualizarFuncionario(request, id)
    +deletarUsuario(id)
  }
  class GerenciamentoProdutoController {
    +gerenciamentoProduto()
    +cadastrarProduto(request)
    +atualizarProduto(request, id)
    +deletarProduto(id)
    +gerenciamentoBordas()
    +cadastrarBorda(request)
    +atualizarBorda(request, id)
  }
  class MesaController {
    +ListarMesa()
    +detalhesMesa(id)
    +abaterItensContaMesa(request, id)
  }
  class GarcomController {
    +index()
    +adicionarProduto(request)
  }
  class SecureKeyController {
    +index()
    +grupo()
    +permissoes()
  }
  class AdminPedidoWhatsAppController {
    +index()
    +buscarCliente(request)
    +store(request)
  }
}

package "Serviços" {
  class GenericBase {
    -repository : GenericBaseRepository
    +findByProdutos(categoria)
    +hasLogado()
    +pegarItensCarrinho(usuarioId)
  }
  class IndexService {
    #produtoRepository : IndexProdutoRepository
    +pegarProdutosIndex()
    +pegarProdutosDestaque()
  }
  class AdminService {
    #genericBase : GenericBase
    #adminRepository : AdminRepository
    #secureKeyService : SecureKeyService
    +montarDashboardAdministrativo(inicio, fim)
    +atualizarDadosEmpresa(dados)
  }
  class AuthService {
    #genericBase : GenericBase
    #authRepository : AuthRepositoryimpl
    +register(dados)
    +autenticarAdm(usuario)
  }
  class LoginService {
    #genericBase : GenericBase
    #secureKeyService : SecureKeyService
    #loginRepository : LoginRepository
    +autenticar(credenciais)
    +recuperarSenha(request)
    +atualizarSenha(request)
  }
  class CarrinhoService {
    #genericBase : GenericBase
    #carrinhoRepository : CarrinhoRepository
    #personalizacaoProdutoService : PersonalizacaoProdutoService
    +adicionarProdutoAoCarrinho(usuario, produtoId, quantidade, observacao, configuracao)
    +registraPedido(request, enderecoId)
  }
  class PedidoService {
    #genericBase : GenericBase
    #service : PedidosFeitosService
    #repository : PedidoRepository
    +pegarPedidosDoUsuario(usuario)
    +montarDadosPainel()
  }
  class PedidosFeitosService {
    -repository : PedidosFeitosRepository
    +atualizarStatus(pedido, status)
    +proximoStatus(status)
    +gerarCumpom(pedidoId)
    +cancelarPedido(pedido)
  }
  class MesasService {
    -mesasRepository : MesasRepository
    +pegarMesas()
    +pegarDetalhesMesa(id)
    +abaterItensContaMesa(request, id)
    +abaterPorValor(mesaId, itemIds, quantidadesPorItem, valorPagamento, pagamentoMetodo)
  }
  class GarcomService {
    -repository : GarcomRepository
    -personalizacaoProdutoService : PersonalizacaoProdutoService
    +adicionarAoPedido(request)
  }
  class GerenciaProdutosService {
    #genericBase : GenericBase
    #repository : GerenciaProdutosRepository
    -otimizadorImagemProduto : OtimizadorImagemProduto
    +criarProduto(request, dadosValidados)
    +atualizarProduto(id, dados)
  }
  class GerenciamentoFuncionarioService {
    #genericBase : GenericBase
    #repository : GerenciamentoFuncionarioRepository
    +atualizarFuncionario(request, id)
  }
  class SecureKeyService {
    -repository : SecureKeyRepository
    +hasRole(usuario, roleName)
    +adicionarRoleAoGrupo(tipoUsuarioId, roleId)
  }
  class PersonalizacaoProdutoService {
    +cotar(produto, configuracao)
  }
  class PedidoRealtimeService {
    -pedidoService : PedidoService
    +payload(pedidoId)
    +broadcast(pedidoId)
  }
  class OtimizadorImagemProduto {
    +salvar(arquivo)
  }
}

package "Interfaces de Repositório" {
  interface AdminRepository {
    +listarDadosEmpresa()
    +totalVendasNoPeriodo(inicio, fim)
    +totalPedidosNoPeriodo(inicio, fim)
  }
  interface AuthRepository {
    +criarUsuario(dados)
    +criarFuncionario(dados)
  }
  interface CarrinhoRepository {
    +buscarProdutoPorId(produtoId)
    +criarItemCarrinho(dados)
    +criarPedido(dados)
  }
  interface GarcomRepository {
    +adicionarProdutoAoPedido(produtoId, mesaId, quantidade, usuarioLogado, observacao, personalizacao, precoUnitario)
    +adicionarProdutosAoPedido(itens, mesaId, usuarioLogado)
  }
  interface GenericBaseRepository {
    +findById(id)
    +findByProdutos(categorias)
    +findFuncionarios()
  }
  interface GerenciaProdutosRepository {
    +listarProdutosComCategoria()
    +criarProduto(dados)
    +atualizarProduto(id, dados)
  }
  interface GerenciamentoFuncionarioRepository {
    +buscarFuncionarioPorUsuarioId(usuarioId)
  }
  interface IndexProdutoRepository {
    +pegarProdutosIndex()
    +pegarProdutosDestaque()
  }
  interface LoginRepository {
    +buscarUsuarioPorEmail(email)
    +inserirTokenRecuperacao(email, token)
    +atualizarSenhaUsuario(email, senhaHash)
  }
  interface MesasRepository {
    +listarMesas()
    +registrarPagamentoMesa(dados)
    +registrarFechamentoMesa(dados)
  }
  interface PedidoRepository {
    +filtrarPedidosDataNome(data, nome)
    +pegarPedidosDoUsuario(usuarioId)
  }
  interface PedidosFeitosRepository {
    +listarPedidos()
    +salvarStatus(pedido, status)
  }
  interface SecureKeyRepository {
    +hasRole(usuario, roleName)
    +adicionarRoleAoGrupo(tipoUsuarioId, roleId)
  }
}

package "Implementações de Repositório" {
  class AdminRepositoryimpl
  class AuthRepositoryimpl
  class CarrinhoRepositoryimpl
  class GarcomRepositoryimpl
  class GenericBaseRepositoryimpl
  class GerenciaProdutosRepositoryimpl
  class GerenciamentoFuncionarioRepositoryimpl
  class IndexProdutoRepositoryimpl
  class LoginRepositoryimpl
  class MesasRepositoryimpl
  class PedidoRepositoryimpl
  class PedidosFeitosRepositoryimpl
  class SecureKeyRepositoryimpl
}

package "Entidades e Modelos" {
  class UsuarioModel <<Authenticatable>> {
    -nome : string
    -email : string
    -senha : string
    -telefone : string
    -tipo_usuario_id : int
    -url_imagem_perfil : string?
    +isFuncionario() : bool
    +isAtivo() : bool
    +pedidos()
    +entregasAtribuidas()
    +Carrinho()
  }
  class FuncionarioModel <<Model>> {
    -usuario_id : int
    -has_ativo : bool
    -salario : double
    +usuario()
  }
  class EnderecoModel <<Model>> {
    -logradouro : string
    -numero : string?
    -complemento : string?
    -bairro : string
    -cidade_id : int
    -usuario_id : int
    +cidade()
    +usuario()
    +pedidos()
  }
  class CidadeModel <<Model>> {
    -nome : string
    +enderecos()
  }
  class PedidoModel <<Model>> {
    -usuario_id : int
    -motoboy_id : int?
    -motoboy_vinculado_em : datetime?
    -mesa_id : int?
    -status : int
    -tipo_pagamento_id : int?
    -valor_total : decimal
    -observacoes_pagamento : string?
    -endereco_id : int?
    +itens()
    +statusRelacionamento()
    +usuario()
    +motoboy()
    +endereco()
    +mesa()
    +formaPagamento()
  }
  class ItemPedidoModel <<Model>> {
    -produto_id : int
    -pedido_id : int
    -quantidade : int
    -preco_unitario : decimal
    -valor_pago : decimal
    -status_da_comanda : string
    -pago_em : datetime?
    -pagamento_metodo : string?
    -observacao : string?
    -personalizacao : array?
    +produto()
    +pedido()
  }
  class ProdutoModel <<Model>> {
    -nome : string
    -preco : decimal
    -descricao : text?
    -imagem_url : string?
    -ingredientes : string?
    -disponivel : bool
    -categoria_id : int
    -no_carrousel : int
    -precos_por_tamanho : array?
    -aceita_meia_por : bool
    -preco_meia_por : decimal?
    +categoria()
    +bordas()
  }
  class CategoriaProdutoModel <<Model>> {
    -nome : string
    +produtos()
  }
  class BordaModel <<Model>> {
    -nome : string
    -adicionais_por_tamanho : array?
    -ativa : bool
    -padrao : bool
    +produtos()
  }
  class CarrinhoModel <<Model>> {
    -usuario_id : int
    -produto_id : int
    -quantidade : int
    -observacao : text?
    -preco_total : decimal
    -selecionado : bool
    -personalizacao : array?
    +usuario()
    +produto()
  }
  class MesaModel <<Model>> {
    -numero_da_mesa : int
    -status : string
    -preco : decimal
    +pedidos()
  }
  class MesaPagamentoModel <<Model>> {
    -mesa_id : int?
    -mesa_fechamento_id : int?
    -pagamento_metodo : string
    -valor : decimal
    -pago_em : datetime?
    +mesa()
    +fechamento()
  }
  class MesaFechamentoModel <<Model>> {
    -mesa_id : int?
    -numero_da_mesa : int
    -total_pago : decimal
    -total_itens : int
    -formas_pagamento : array?
    -pagamentos_resumo : array?
    -produtos_resumo : array?
    -fechado_em : datetime?
    +mesa()
    +pagamentos()
  }
  class FormaPagamentoModel <<Model>> {
    -tipo_pagamento : string
    +pedidos()
  }
  class StatusModel <<Model>> {
    -status : string
    +pedidos()
  }
  class RolesModel <<Model>> {
    -nome : string
    +SecureKeyTipoUsuarios()
  }
  class SecureKeyTipoUsuarioModel <<Model>> {
    -tipo_usuario_id : int
    -role_id : int
    +roles()
    +tipoUsuario()
  }
  class Dados_empresa <<Model>> {
    -id : int
    -Informacao : string
    -Valor : string
  }
  class ConfiguracaoImpressao <<Model>> {
    -configuracoes : array
    {static} +atuais() : array
    {static} +salvar(configuracoes) : void
  }
}

package "Tabela de Banco sem Model Eloquent" {
  class TipoUsuarioRegistro <<Tabela SQL>> {
    -id : int
    -descricao : string
  }
}

package "Enums e Suporte" {
  class TipoUsuario <<enumeration>> {
    CLIENTE = 1
    ESTABELECIMENTO = 2
    ADMINISTRADOR = 3
    ENTREGADOR = 4
    SecureKey = 5
    GARCOM = 6
    +label() : string
  }
  class StatusPedidos <<enumeration>> {
    PENDENTE = 1
    EM_PREPARO = 2
    A_CAMINHO = 3
    ENTREGUE = 4
    CANCELADO = 5
    +rotulo() : string
    +proximo() : ?StatusPedidos
  }
  class Pagamento <<enumeration>> {
    CARTAO_CREDITO = 1
    CARTAO_DEBITO = 2
    PIX = 3
    DINHEIRO = 4
    {static} +fromString(nome : string) : Pagamento
  }
  class PedidosAtualizados <<Event>> {
    -payload : array
    +broadcastOn()
    +broadcastAs()
    +broadcastWith()
  }
  class UsuarioAutenticado <<Middleware>> {
    +handle(request, next)
  }
  class PedidoObserver <<Observer>> {
    -pedidoRealtimeService : PedidoRealtimeService
    +created(pedido)
    +updated(pedido)
    +deleted(pedido)
  }
  class AppServiceProvider <<ServiceProvider>> {
    +register()
    +boot()
  }
  class Roles <<Constants>>
  class PassMensagens <<Constants>>
  class ErroMensagens <<Constants>>
}

